# Atlassian account email + a Bitbucket API token
# (bitbucket.org → Personal settings → Atlassian account settings → Security → API tokens,
#  "Create API token with scopes", app: Bitbucket).
# Scopes: read:user:bitbucket, read:repository:bitbucket,
#         read:pullrequest:bitbucket, write:pullrequest:bitbucket
BITBUCKET_EMAIL=you@example.com
BITBUCKET_API_TOKEN=

# Workspace and the repositories whose open pull requests you want listed.
BITBUCKET_WORKSPACE=igne
BITBUCKET_REPOS=phase2-web,phase2-declarations-web

# Port of the local review app.
PORT=5390
